# =============================================================================
# MLOps Dashboard - 環境設定例
# このファイルを .env にコピーして適宜編集してください。
# =============================================================================

# アプリ動作モード
# local_dev : SQLite を使用（デフォルト。開発・ローカル検証用）
# dev        : Dataiku DSS 開発環境からデータ取得
# production : Dataiku DSS 本番環境からデータ取得
APP_MODE=local_dev

# ダッシュボード自動更新の有効化フラグ（false で全ページの自動更新を停止）
# true | false（デフォルト: true）
AUTO_REFRESH_ENABLED=true

# 自動更新間隔の初期値（秒、1 以上の整数）
# 管理ページの「表示設定」から変更でき、変更値は各ブラウザに保存される。
# 以下は未設定のブラウザで使われる初期値（サマリー: 60 秒、詳細: 30 秒）
AUTO_REFRESH_SUMMARY_SECONDS=60
AUTO_REFRESH_DETAIL_SECONDS=30

# ログレベル: DEBUG | INFO | WARNING | ERROR | CRITICAL（デフォルト: DEBUG）
# DEBUG のときは各バックエンド関数の呼び出しログ（@log_call）も出力される
LOG_LEVEL=DEBUG

# =============================================================================
# local_dev モード設定
# =============================================================================

# SQLite データベースファイルパス
DATABASE_URL=sqlite:///./mlops.db

# =============================================================================
# dev / production モード設定 (Dataiku)
# =============================================================================

# Dataiku DSS 接続情報
# ※ DSS webapp 内（バックエンドレシピ等）で実行する場合は不要
#    外部サーバーから接続する場合のみ設定
DATAIKU_HOST=https://your-dss-host.example.com
DATAIKU_API_KEY=your-api-key-here

# =============================================================================
# Dataiku プロジェクト構成
# =============================================================================

# 管理プロジェクト: m_projects のマスタデータを格納するプロジェクト
# m_projects.project_name が各 Ops 対象プロジェクトの Dataiku プロジェクトキーになる
DATAIKU_MGMT_PROJECT_KEY=mlops_dev

# =============================================================================
# Dataiku データセット名（デフォルトのままで通常は変更不要）
# =============================================================================
# 管理プロジェクト (mlops_dev) 内のデータセット
DKU_DATASET_PROJECTS=m_projects
DKU_DATASET_PROJECT_CONFIGS=m_project_configs

# 各 Ops 対象プロジェクト内のデータセット（project_name で解決したプロジェクトから取得）
DKU_DATASET_INFERENCE_LOGS=t_inference_logs
DKU_DATASET_DEPLOYED_MODELS=t_deployed_models
DKU_DATASET_REFERENCE_LOGS=t_reference_logs
